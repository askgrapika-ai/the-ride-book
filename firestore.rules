rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Is the requester an authenticated admin? ──
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Orders ────────────────────────────────────────────
    match /orders/{orderId} {
      // Anyone can fetch a specific order by ID (for tracking page)
      allow get: if true;
      // Only admins can list all orders (for admin dashboard)
      allow list: if isAdmin();
      // Writing/updating orders is done server-side
      allow write: if false;
    }

    // ── Feedback ──────────────────────────────────────────
    match /feedback/{feedbackId} {
      // Anyone can submit feedback (create)
      allow create: if request.resource.data.rating is int &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.feedback is string &&
                       request.resource.data.feedback.size() > 0 &&
                       request.resource.data.approved == false;

      // Only admins can read and update approval status
      allow read, update, delete: if isAdmin();
    }

    // ── Book / Inventory ──────────────────────────────────
    match /book/{bookId} {
      // Anyone can read book info (price, stock status)
      allow read: if true;
      // Only admins can update
      allow write: if isAdmin();
    }

    // ── Counters ──────────────────────────────────────────
    match /counters/{counterId} {
      // Only server-side Admin SDK (via API routes) can touch counters
      allow read, write: if false;
    }

    // ── Admins ────────────────────────────────────────────
    match /admins/{uid} {
      // Only the admin can read their own record
      allow read: if request.auth != null && request.auth.uid == uid;
      // Only existing admins can write (prevents self-registration)
      allow write: if isAdmin();
    }
  }
}
